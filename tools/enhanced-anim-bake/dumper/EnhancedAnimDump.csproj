    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>enhanced-anim-dump</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UexBin Condition="'$(UexBin)' == ''">$(USERPROFILE)\.claude\skills\extracting-unreal-assets\tool\bin\uex</UexBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(UexBin)\*.dll" Exclude="$(UexBin)\uex.dll;$(UexBin)\oodle-data-shared.dll" Private="true" />
  </ItemGroup>
</Project>
