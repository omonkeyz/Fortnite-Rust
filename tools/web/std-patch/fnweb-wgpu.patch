+#[derive(Debug)]
+pub(crate) enum FnwebRes { T(webgpu_sys::GpuTexture), B(webgpu_sys::GpuBuffer) }
+#[derive(Debug)]
+pub(crate) struct FnwebLife(Option<FnwebRes>);
+std::thread_local! {
+    static FNWEB_PENDING: RefCell<Vec<(u64, FnwebRes)>> = const { RefCell::new(Vec::new()) };
+    static FNWEB_SUBMITS: core::cell::Cell<u64> = const { core::cell::Cell::new(0) };
+}
+impl Drop for FnwebLife {
+    fn drop(&mut self) {
+        if let Some(r) = self.0.take() {
+            let s = FNWEB_SUBMITS.with(|c| c.get());
+            let _ = FNWEB_PENDING.try_with(|p| p.borrow_mut().push((s, r)));
+        }
+    }
+}
+fn fnweb_after_submit() {
+    let n = FNWEB_SUBMITS.with(|c| { c.set(c.get() + 1); c.get() });
+    let due: Vec<FnwebRes> = FNWEB_PENDING.with(|p| {
+        let mut p = p.borrow_mut();
+        if p.is_empty() || p[0].0 + 3 > n { return Vec::new(); }
+        let k = p.iter().position(|e| e.0 + 3 > n).unwrap_or(p.len());
+        p.drain(..k).map(|e| e.1).collect()
+    });
+    for r in due {
+        match r { FnwebRes::T(t) => t.destroy(), FnwebRes::B(b) => b.destroy() }
+    }
+}
