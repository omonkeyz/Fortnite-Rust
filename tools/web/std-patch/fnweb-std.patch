+//! FNWEB: file system of the Fortnite 1.8 browser port. Every operation is forwarded to the application's virtual file system
+//! (`sys/pal/wasm/fnweb.rs` hooks; implemented by tools/web/fn-web-rt on top of the local launcher's HTTP API: ranged reads of the
+//! user's own game files, a writable per-user folder). Paths are `/`-separated UTF-8 strings (`/fn/paks/...`, `/fn/assets/...`).
+
+use crate::ffi::OsString;
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::{Hash, Hasher};
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Path, PathBuf};
+use crate::sync::atomic::{AtomicU64, Ordering};
+pub use crate::sys::fs::common::{Dir, ExtraHomeDirs, ExtraMediaDirs};
+use crate::sys::pal::fnweb;
+use crate::sys::time::SystemTime;
+use crate::sys::unsupported;
+use crate::time::Duration;
+
+const KIND_FILE: u8 = 1;
+const KIND_DIR: u8 = 2;
+
+pub struct File {
+    handle: u64,
+    pos: AtomicU64,
+    append: bool,
+    path: PathBuf,
+}
+
+#[derive(Clone)]
+pub struct FileAttr {
+    kind: u8,
+    size: u64,
+    modified_ms: f64,
+}
+
+pub struct ReadDir {
+    dir: PathBuf,
+    entries: crate::vec::IntoIter<(String, u8, u64, f64)>,
+}
+
+pub struct DirEntry {
+    dir: PathBuf,
+    name: String,
+    attr: FileAttr,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {}
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub struct FileType {
+    kind: u8,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+fn system_time(ms: f64) -> SystemTime {
+    // UNIX_EPOCH + ms
+    crate::sys::time::UNIX_EPOCH.checked_add_duration(&Duration::from_secs_f64(ms.max(0.0) / 1000.0)).unwrap_or(crate::sys::time::UNIX_EPOCH)
+}
+
+impl FileAttr {
+    fn from_stat((kind, size, modified_ms): (u8, u64, f64)) -> FileAttr {
+        FileAttr { kind, size, modified_ms }
+    }
+
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { readonly: false }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        FileType { kind: self.kind }
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(system_time(self.modified_ms))
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        Ok(system_time(self.modified_ms))
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Ok(system_time(self.modified_ms))
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.readonly
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        self.readonly = readonly
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, _t: SystemTime) {}
+    pub fn set_modified(&mut self, _t: SystemTime) {}
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.kind == KIND_DIR
+    }
+
+    pub fn is_file(&self) -> bool {
+        self.kind == KIND_FILE
+    }
+
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ReadDir").field("dir", &self.dir).finish()
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        let (name, kind, size, modified_ms) = self.entries.next()?;
+        Some(Ok(DirEntry { dir: self.dir.clone(), name, attr: FileAttr { kind, size, modified_ms } }))
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.dir.join(&self.name)
+    }
+
+    pub fn file_name(&self) -> OsString {
+        OsString::from(self.name.clone())
+    }
+
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        Ok(self.attr.clone())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.attr.file_type())
+    }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new
+    }
+
+    fn flags(&self) -> u32 {
+        (self.read as u32)
+            | ((self.write as u32) << 1)
+            | ((self.append as u32) << 2)
+            | ((self.truncate as u32) << 3)
+            | ((self.create as u32) << 4)
+            | ((self.create_new as u32) << 5)
+    }
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let handle = fnweb::fs_open(fnweb::path_str(path)?, opts.flags())?;
+        Ok(File { handle, pos: AtomicU64::new(0), append: opts.append, path: path.to_path_buf() })
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        match fnweb::fs_stat(fnweb::path_str(&self.path)?) {
+            Ok(s) => Ok(FileAttr::from_stat(s)),
+            Err(_) => Ok(FileAttr { kind: KIND_FILE, size: fnweb::fs_size(self.handle)?, modified_ms: 0.0 }),
+        }
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        fnweb::fs_flush(self.handle)
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        fnweb::fs_flush(self.handle)
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        fnweb::fs_set_len(self.handle, size)
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        let pos = self.pos.load(Ordering::Relaxed);
+        let n = fnweb::fs_read_at(self.handle, pos, buf)?;
+        self.pos.store(pos + n as u64, Ordering::Relaxed);
+        Ok(n)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        match bufs.iter_mut().find(|b| !b.is_empty()) {
+            Some(b) => self.read(b),
+            None => Ok(0),
+        }
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_buf(&self, mut cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        let n = self.read(cursor.ensure_init())?;
+        cursor.advance_checked(n);
+        Ok(())
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        let pos = if self.append { fnweb::fs_size(self.handle)? } else { self.pos.load(Ordering::Relaxed) };
+        let n = fnweb::fs_write_at(self.handle, pos, buf)?;
+        self.pos.store(pos + n as u64, Ordering::Relaxed);
+        Ok(n)
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        match bufs.iter().find(|b| !b.is_empty()) {
+            Some(b) => self.write(b),
+            None => Ok(0),
+        }
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        fnweb::fs_flush(self.handle)
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let new = match pos {
+            SeekFrom::Start(n) => Some(n),
+            SeekFrom::End(d) => fnweb::fs_size(self.handle)?.checked_add_signed(d),
+            SeekFrom::Current(d) => self.pos.load(Ordering::Relaxed).checked_add_signed(d),
+        };
+        let new = new.ok_or_else(|| io::const_error!(io::ErrorKind::InvalidInput, "invalid seek to a negative or overflowing position"))?;
+        self.pos.store(new, Ordering::Relaxed);
+        Ok(new)
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(fnweb::fs_size(self.handle))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        Ok(self.pos.load(Ordering::Relaxed))
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        unsupported()
+    }
+
+    pub fn set_permissions(&self, _perm: FilePermissions) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn set_times(&self, _times: FileTimes) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+impl Drop for File {
+    fn drop(&mut self) {
+        fnweb::fs_close(self.handle);
+    }
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder {}
+    }
+
+    pub fn mkdir(&self, p: &Path) -> io::Result<()> {
+        fnweb::fs_mkdir(fnweb::path_str(p)?)
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("File").field("path", &self.path).field("handle", &self.handle).finish()
+    }
+}
+
+impl Hash for FileAttr {
+    fn hash<H: Hasher>(&self, h: &mut H) {
+        self.kind.hash(h);
+        self.size.hash(h);
+    }
+}
+
+impl fmt::Debug for FileAttr {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FileAttr").field("kind", &self.kind).field("size", &self.size).finish()
+    }
+}
+
+pub fn readdir(p: &Path) -> io::Result<ReadDir> {
+    let entries = fnweb::fs_readdir(fnweb::path_str(p)?)?;
+    Ok(ReadDir { dir: p.to_path_buf(), entries: entries.into_iter() })
+}
+
+pub fn unlink(p: &Path) -> io::Result<()> {
+    fnweb::fs_unlink(fnweb::path_str(p)?)
+}
+
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    fnweb::fs_rename(fnweb::path_str(old)?, fnweb::path_str(new)?)
+}
+
+pub fn set_perm(_p: &Path, _perm: FilePermissions) -> io::Result<()> {
+    Ok(())
+}
+
+pub fn set_perm_nofollow(_p: &Path, _perm: FilePermissions) -> io::Result<()> {
+    Ok(())
+}
+
+pub fn set_times(_p: &Path, _times: FileTimes) -> io::Result<()> {
+    Ok(())
+}
+
+pub fn set_times_nofollow(_p: &Path, _times: FileTimes) -> io::Result<()> {
+    Ok(())
+}
+
+pub fn rmdir(p: &Path) -> io::Result<()> {
+    fnweb::fs_rmdir(fnweb::path_str(p)?)
+}
+
+pub fn remove_dir_all(path: &Path) -> io::Result<()> {
+    crate::sys::fs::common::remove_dir_all(path)
+}
+
+pub fn exists(path: &Path) -> io::Result<bool> {
+    match fnweb::fs_stat(fnweb::path_str(path)?) {
+        Ok(_) => Ok(true),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(e) => Err(e),
+    }
+}
+
+pub fn readlink(_p: &Path) -> io::Result<PathBuf> {
+    unsupported()
+}
+
+pub fn symlink(_original: &Path, _link: &Path) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn link(_src: &Path, _dst: &Path) -> io::Result<()> {
+    unsupported()
+}
+
+pub fn stat(p: &Path) -> io::Result<FileAttr> {
+    fnweb::fs_stat(fnweb::path_str(p)?).map(FileAttr::from_stat)
+}
+
+pub fn lstat(p: &Path) -> io::Result<FileAttr> {
+    stat(p)
+}
+
+/// Lexically normalised absolute path (relative paths are taken from the working directory); the target must exist.
+pub fn canonicalize(p: &Path) -> io::Result<PathBuf> {
+    let abs = if p.is_absolute() { p.to_path_buf() } else { crate::env::current_dir()?.join(p) };
+    let mut out = PathBuf::from("/");
+    for c in abs.components() {
+        match c {
+            crate::path::Component::ParentDir => {
+                out.pop();
+            }
+            crate::path::Component::Normal(n) => out.push(n),
+            _ => {}
+        }
+    }
+    stat(&out)?;
+    Ok(out)
+}
+
+pub fn copy(from: &Path, to: &Path) -> io::Result<u64> {
+    crate::sys::fs::common::copy(from, to)
+}
