+//! FNWEB: paths of the Fortnite 1.8 browser port. The application's virtual file system serves `/fn/...`; the executable "lives" in
+//! `FNWEB_EXE` (default `/fn/bin/fortnite-rs.exe`), the working directory is `FNWEB_CWD` (default `/fn/bin`), home `/fn/user`, temp `/fn/tmp`.
+
+use crate::ffi::{OsStr, OsString};
+use crate::path::{self, Path, PathBuf};
+use crate::sys::pal::fnweb;
+use crate::{fmt, io};
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    Ok(PathBuf::from(fnweb::getenv("FNWEB_CWD").unwrap_or_else(|| "/fn/bin".into())))
+}
+
+pub fn chdir(p: &path::Path) -> io::Result<()> {
+    fnweb::setenv("FNWEB_CWD", Some(fnweb::path_str(p)?));
+    Ok(())
+}
+
+pub struct SplitPaths<'a> {
+    iter: crate::str::Split<'a, char>,
+}
+pub struct SplitPathsRef<'a> {
+    iter: crate::str::Split<'a, char>,
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    SplitPaths { iter: unparsed.to_str().unwrap_or("").split(':') }
+}
+
+pub fn split_paths_ref(unparsed: &OsStr) -> Option<SplitPathsRef<'_>> {
+    Some(SplitPathsRef { iter: unparsed.to_str()?.split(':') })
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+    fn next(&mut self) -> Option<PathBuf> {
+        self.iter.next().map(PathBuf::from)
+    }
+}
+
+impl<'a> Iterator for SplitPathsRef<'a> {
+    type Item = &'a Path;
+    fn next(&mut self) -> Option<&'a Path> {
+        self.iter.next().map(Path::new)
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut out = OsString::new();
+    for (i, p) in paths.enumerate() {
+        let p = p.as_ref();
+        if p.to_str().map_or(true, |s| s.contains(':')) {
+            return Err(JoinPathsError);
+        }
+        if i > 0 {
+            out.push(":");
+        }
+        out.push(p);
+    }
+    Ok(out)
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        "path segment contains separator `:`".fmt(f)
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+pub fn current_exe() -> io::Result<PathBuf> {
+    Ok(PathBuf::from(fnweb::getenv("FNWEB_EXE").unwrap_or_else(|| "/fn/bin/fortnite-rs.exe".into())))
+}
+
+pub fn temp_dir() -> PathBuf {
+    PathBuf::from(fnweb::getenv("TMPDIR").unwrap_or_else(|| "/fn/tmp".into()))
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    Some(PathBuf::from(fnweb::getenv("HOME").unwrap_or_else(|| "/fn/user".into())))
+}
