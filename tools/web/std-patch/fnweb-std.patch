@@ -0,0 +1,95 @@
+//! FNWEB: hooks into the browser platform layer of the Fortnite 1.8 browser port (wasm32-unknown-unknown with atomics).
+//!
+//! std declares these `extern "Rust"` functions; the application defines them with `#[no_mangle]` (crate `fn-web-rt`). Both sides are compiled by the
+//! same rustc in the same build (`-Z build-std`), so std types (`io::Result`, `String`, `Vec`) may cross the boundary.
+#![allow(dead_code)]
+
+use crate::io;
+use crate::sync::atomic::{Atomic, Ordering};
+use crate::time::Duration;
+
+unsafe extern "Rust" {
+    /// False on the browser main thread (it must never execute `memory.atomic.wait`), true on Web Workers.
+    safe fn __fnweb_can_block() -> bool;
+    /// Monotonic clock in milliseconds: `performance.timeOrigin + performance.now()` (the same origin on every thread).
+    safe fn __fnweb_now_ms() -> f64;
+    /// Wall clock in milliseconds since the Unix epoch (`Date.now()`).
+    safe fn __fnweb_wall_ms() -> f64;
+    /// `fd` 1 = stdout, 2 = stderr.
+    safe fn __fnweb_stdio_write(fd: u32, buf: &[u8]);
+    safe fn __fnweb_getenv(key: &str) -> Option<String>;
+    safe fn __fnweb_setenv(key: &str, value: Option<&str>);
