+//! FNWEB: std threads of the Fortnite 1.8 browser port. A thread is a job handed to a pool of Web Workers that were started before `main`
+//! (a Worker created later only starts once the main thread returns to the event loop, so spawn-then-join on the main thread would deadlock).
+//! A worker runs one job after the other: when a job ends, the worker's "current thread" handle and id are reset so the next job can be a new
+//! std thread. Thread-local values are NOT destroyed between jobs (std's TLS slots can never be revived after destruction); they persist on the
+//! worker like in any thread pool.
+
+use crate::ffi::CStr;
+use crate::io;
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{Atomic, Ordering};
+use crate::sys::pal::fnweb;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 2 * 1024 * 1024;
+
+pub struct Thread {
+    done: Arc<Atomic<u32>>,
+}
+
+fn wake_all(flag: &Atomic<u32>) {
+    // SAFETY: a valid, aligned u32 in shared memory
+    unsafe { core::arch::wasm32::memory_atomic_notify(flag.as_ptr() as *mut i32, u32::MAX) };
+}
+
+fn wait_while_zero(flag: &Atomic<u32>) {
+    while flag.load(Ordering::Acquire) == 0 {
+        if fnweb::can_block() {
+            // SAFETY: a valid, aligned u32 in shared memory; returns on notify / value change
+            unsafe { core::arch::wasm32::memory_atomic_wait32(flag.as_ptr() as *mut i32, 0, -1) };
+        } else {
+            fnweb::spin_wait(flag, 0, None);
+        }
+    }
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(_stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        let done: Arc<Atomic<u32>> = Arc::new(Atomic::<u32>::new(0));
+        let flag = done.clone();
+        let job: Box<dyn FnOnce()> = Box::new(move || {
+            let rust_start = init.init();
+            rust_start();
+            crate::thread::fnweb_reset_current();
+            flag.store(1, Ordering::Release);
+            wake_all(&flag);
+        });
+        let raw = Box::into_raw(Box::new(job)) as *mut u8;
+        // SAFETY: `raw` comes from Box::into_raw(Box::new(Box<dyn FnOnce()>)); the hook takes ownership when it returns true.
+        if unsafe { fnweb::thread_spawn(raw) } {
+            Ok(Thread { done })
+        } else {
+            // SAFETY: not consumed by the hook: reclaim it.
+            drop(unsafe { Box::from_raw(raw as *mut Box<dyn FnOnce()>) });
+            Err(io::const_error!(io::ErrorKind::WouldBlock, "no browser worker available for a new thread"))
+        }
+    }
+
+    pub fn join(self) {
+        wait_while_zero(&self.done);
+    }
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    NonZero::new(fnweb::parallelism()).ok_or(io::Error::UNKNOWN_THREAD_COUNT)
+}
+
+pub fn yield_now() {
+    crate::hint::spin_loop();
+}
+
+#[allow(dead_code)]
+pub fn set_name(_name: &CStr) {}
+
+pub fn sleep(dur: Duration) {
+    if dur.is_zero() {
+        return;
+    }
+    if fnweb::can_block() {
+        let mut nanos = dur.as_nanos();
+        while nanos > 0 {
+            let amt = crate::cmp::min(i64::MAX as u128, nanos);
+            let mut x = 0;
+            // SAFETY: a private stack word; we are only woken by the timeout.
+            let _ = unsafe { core::arch::wasm32::memory_atomic_wait32(&mut x, 0, amt as i64) };
+            nanos -= amt;
+        }
+    } else {
+        // the main thread spins (a sleep there blocks the page: callers should not sleep on it)
+        let end = fnweb::now_ms() + dur.as_secs_f64() * 1000.0;
+        while fnweb::now_ms() < end {
+            crate::hint::spin_loop();
+        }
+    }
+}
