+/// FNWEB: a browser-port pool worker finished one std thread's job: forget its handle and id so the worker can start the next std thread
+/// (`set_current` refuses a second handle on the same OS thread). See sys/thread/fnweb.rs.
+#[cfg(all(target_family = "wasm", target_os = "unknown", target_feature = "atomics"))]
+pub(crate) fn fnweb_reset_current() {
+    let current = CURRENT.get();
+    CURRENT.set(NONE);
+    if current > DESTROYED {
+        // SAFETY: CURRENT held a handle created by `Thread::into_raw` (set_current / init_current).
+        unsafe { drop(Thread::from_raw(current)) };
+    }
+    id::fnweb_reset();
