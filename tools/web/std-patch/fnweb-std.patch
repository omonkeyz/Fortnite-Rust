+/// The browser main thread may not execute `memory.atomic.wait` (it traps): it spins instead, like Emscripten's pthreads on the main thread.
+/// Returns false on timeout, true otherwise (value changed).
+pub fn spin_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    let deadline = timeout.map(|t| now_ms() + t.as_secs_f64() * 1000.0);
+    let mut n: u32 = 0;
+    loop {
+        if futex.load(Ordering::Acquire) != expected {
+            return true;
+        }
+        n = n.wrapping_add(1);
+        if n % 256 == 0 {
+            if let Some(d) = deadline {
+                if now_ms() >= d {
+                    return false;
+                }
+            }
+        }
+        crate::hint::spin_loop();
+    }
+}
